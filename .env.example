DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
NEXT_PUBLIC_WHATSAPP_SUPPORT_URL="https://wa.me/5500000000000?text=Ola%2C%20quero%20suporte"

# Prisma seed bootstrap (required only when running `npx prisma db seed`)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Rate limit driver: memory | upstash
RATE_LIMIT_DRIVER="memory"

# If true and Upstash is unavailable, fallback to in-memory limiter.
RATE_LIMIT_FAILOVER_TO_MEMORY="true"

# Required only when RATE_LIMIT_DRIVER=upstash
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Global CSP rollout: report-only | enforce
CSP_MODE="report-only"

# Optional CSP report endpoint URL
CSP_REPORT_URI=""

# Observability alerts (webhook)
OBS_ALERT_ENABLED="false"
OBS_ALERT_WEBHOOK_URL=""
OBS_ALERT_COOLDOWN_SECONDS="300"
# Alert window in minutes for spike detection
OBS_ALERT_WINDOW_MINUTES="5"
# Legacy single-threshold compatibility (critical fallback)
OBS_ALERT_RATE_LIMIT_THRESHOLD="20"
OBS_ALERT_ERROR_THRESHOLD="10"
# Calibrated thresholds by severity (preferred)
OBS_ALERT_RATE_LIMIT_THRESHOLD_WARNING="12"
OBS_ALERT_RATE_LIMIT_THRESHOLD_CRITICAL="20"
OBS_ALERT_ERROR_THRESHOLD_WARNING="6"
OBS_ALERT_ERROR_THRESHOLD_CRITICAL="10"
