generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NOVO
  EM_ATENDIMENTO
  CONVERTIDO
  DESCARTADO
  ARQUIVADO
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Plan {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  downloadMbps  Int
  uploadMbps    Int
  latencyTarget Int
  priceCents    Int
  featured      Boolean  @default(false)
  benefitsJson  Json
  badge         String?
  isActive      Boolean  @default(true)
  leads         Lead[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CoverageArea {
  id          String   @id @default(uuid())
  city        String
  district    String
  cepStart    String
  cepEnd      String
  isAvailable Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id         String     @id @default(uuid())
  name       String
  email      String?
  phone      String?
  city       String?
  district   String?
  cep        String?
  message    String?
  planId     String?
  plan       Plan?      @relation(fields: [planId], references: [id])
  source     String?
  status     LeadStatus @default(NOVO)
  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

enum ContactMessageStatus {
  NOVA
  LIDA
  RESPONDIDA
  ARQUIVADA
}

model ContactMessage {
  id         String               @id @default(uuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  status     ContactMessageStatus @default(NOVA)
  readAt     DateTime?
  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([deletedAt])
}

model FAQ {
  id          String   @id @default(uuid())
  question    String
  answer      String
  category    String?
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NetworkStatus {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  status      String
  description String?
  startedAt   DateTime?
  resolvedAt  DateTime?
  isVisible   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  entity       String
  entityId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())
}